# Ask Sila Frontend Environment Variables

# In Local Development:
# Leave VITE_API_URL empty so Vite automatically proxies '/api' to 'http://localhost:5000'
# VITE_API_URL=

# In Production (e.g. Vercel, Netlify, Render):
# Set this to your deployed Render backend web service URL:
VITE_API_URL=https://ask-sila-backend.onrender.com
